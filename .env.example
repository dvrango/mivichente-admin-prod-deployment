# Vichente Admin — variables de entorno
# Copia este archivo a .env.local y rellena con valores reales.
# Nunca commitear .env.local.
# Las vars se validan en src/lib/env.ts — el build falla si falta una.

# "local" muestra el banner de ambiente. En producción omitir o poner "production".
NEXT_PUBLIC_APP_ENV=local

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo server-side. Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API: aviso del pedido al restaurante (njr8m6mp2). Solo server.
# Sin ellas, /api/orders/notify y /api/whatsapp/webhook responden 503.
# El token es el de un usuario de sistema; el app secret firma los webhooks;
# el verify token lo eliges tú (16+ caracteres) y se pega igual en Meta.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
